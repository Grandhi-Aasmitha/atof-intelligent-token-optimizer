{
  "name": "atof-selection-optimizer",
  "displayName": "ATOF Control Center",
  "description": "Shared local optimization controls and approved VS Code model and MCP integrations",
  "version": "0.9.3",
  "publisher": "atof-local",
  "private": true,
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "atof.openDashboard",
        "title": "ATOF: Open Control Center"
      },
      {
        "command": "atof.toggleOptimization",
        "title": "ATOF: Toggle Optimization"
      },
      {
        "command": "atof.askAI",
        "title": "ATOF: Ask AI with ATOF"
      },
      {
        "command": "atof.optimizeSelection",
        "title": "ATOF: Optimize Selection (Local Candidate Only)"
      },
      {
        "command": "atof.configureCopilot",
        "title": "ATOF: Configure Optional Copilot MCP"
      },
      {
        "command": "atof.disableCopilot",
        "title": "ATOF: Remove Extension-Provided Copilot MCP"
      }
    ],
    "configuration": {
      "title": "ATOF",
      "properties": {
        "atof.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8081",
          "scope": "machine",
          "description": "Local ATOF service origin; HTTP loopback only."
        },
        "atof.tokenBudget": {
          "type": "integer",
          "default": 1600,
          "minimum": 64,
          "scope": "machine"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "atof.askAI",
          "when": "editorHasSelection",
          "group": "navigation@50"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "atof.localMcp",
        "label": "ATOF (optional Copilot MCP)"
      }
    ],
    "languageModelTools": [
      {
        "name": "atof_read_context",
        "displayName": "ATOF: Read optimized source",
        "toolReferenceName": "atofContext",
        "canBeReferencedInPrompt": true,
        "when": "atof.optimizationEnabled && isWorkspaceTrusted",
        "userDescription": "Read and optimize authorized source files or a saved diagnostic artifact.",
        "modelDescription": "For read-only code explanations, dependency and repository questions, saved build/error/test logs or saved diffs, prefer this tool before reading full evidence. Discover relevant paths with normal authorized workspace search; pass up to eight source paths or one saved artifact and the actual task. Never use for edits or exact full-file reviews. If insufficient, use ordinary authorized tools.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task"
          ],
          "properties": {
            "task": {
              "type": "string",
              "description": "Actual narrow task including target symbol"
            },
            "path": {
              "type": "string",
              "description": "Source file path relative to the single trusted local workspace"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string"
              },
              "description": "Relevant workspace-relative paths discovered using authorized search"
            },
            "kind": {
              "type": "string",
              "enum": [
                "source",
                "error_output",
                "test_output",
                "diff"
              ],
              "description": "Saved evidence type; default source"
            }
          }
        }
      }
    ],
    "chatInstructions": [
      {
        "path": "./agents/atof.instructions.md",
        "when": "atof.optimizationEnabled && isWorkspaceTrusted"
      }
    ],
    "chatAgents": [
      {
        "path": "./agents/atof.agent.md"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js && node --check client.js && node --check owned.js && node --check chat-tool.js",
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies"
  },
  "license": "UNLICENSED",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Grandhi-Aasmitha/atof-intelligent-token-optimizer.git",
    "directory": "ide/vscode"
  }
}
